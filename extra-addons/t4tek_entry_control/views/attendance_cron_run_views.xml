<odoo>
    <record id="view_entry_control_attendance_cron_run_list" model="ir.ui.view">
        <field name="name">entry.control.attendance.cron.run.list</field>
        <field name="model">entry.control.attendance.cron.run</field>
        <field name="arch" type="xml">
            <list string="Attendance Processing Ledger" decoration-success="status == 'done'" decoration-warning="status == 'running'" decoration-danger="status == 'failed'">
                <field name="controller_id"/>
                <field name="business_date"/>
                <field name="timezone"/>
                <field name="local_run_time"/>
                <field name="due_at_utc"/>
                <field name="status" widget="badge" decoration-success="status == 'done'" decoration-warning="status == 'running'" decoration-danger="status == 'failed'"/>
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="log_count"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="skipped_count"/>
                <field name="failed_count"/>
            </list>
        </field>
    </record>

    <record id="view_entry_control_attendance_cron_run_form" model="ir.ui.view">
        <field name="name">entry.control.attendance.cron.run.form</field>
        <field name="model">entry.control.attendance.cron.run</field>
        <field name="arch" type="xml">
            <form string="Attendance Processing Ledger">
                <sheet>
                    <group>
                        <group string="Scope">
                            <field name="controller_id" readonly="1"/>
                            <field name="business_date" readonly="1"/>
                            <field name="timezone" readonly="1"/>
                            <field name="local_run_time" readonly="1"/>
                            <field name="due_at_utc" readonly="1"/>
                            <field name="status" readonly="1" widget="badge"/>
                        </group>
                        <group string="Execution">
                            <field name="started_at" readonly="1"/>
                            <field name="local_started_at" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                            <field name="db_start" readonly="1"/>
                            <field name="db_end" readonly="1"/>
                        </group>
                    </group>
                    <group string="Metrics">
                        <field name="employee_count" readonly="1"/>
                        <field name="log_count" readonly="1"/>
                        <field name="created_count" readonly="1"/>
                        <field name="updated_count" readonly="1"/>
                        <field name="skipped_count" readonly="1"/>
                        <field name="failed_count" readonly="1"/>
                    </group>
                    <group string="Error">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_entry_control_attendance_cron_run" model="ir.actions.act_window">
        <field name="name">Processing Ledger</field>
        <field name="res_model">entry.control.attendance.cron.run</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
