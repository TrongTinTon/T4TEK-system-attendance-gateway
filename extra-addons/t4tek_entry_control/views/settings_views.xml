<odoo>
    <record id="view_entry_control_settings_form" model="ir.ui.view">
        <field name="name">entry.control.settings.form</field>
        <field name="model">entry.control.settings</field>
        <field name="arch" type="xml">
            <form string="Gatekeeper Settings">
                <sheet>
                    <group string="Default Timezone">
                        <field name="attendance_timezone" placeholder="Asia/Ho_Chi_Minh"/>
                        <div class="text-muted" colspan="2">Fallback timezone used only for new Controllers or legacy logs without Controller. Normal attendance processing uses each Controller's own timezone.</div>
                    </group>
                    <group string="Periodic Cron Policy">
                        <field name="daily_cron_local_run_time" placeholder="00:00"/>
                        <field name="controller_heartbeat_timeout_seconds"/>
                        <div class="text-muted" colspan="2">Odoo Scheduled Action should run periodically in UTC, for example every 15 minutes. Each Controller is processed only when its own local time reaches this HH:MM value.</div>
                    </group>
                    <group string="Daily Cron Diagnostics">
                        <div class="text-muted" colspan="2">UTC is the value stored/queried by Odoo. Cron processing is grouped by each Controller Timezone and guarded by the processing ledger.</div>
                        <field name="last_cron_at_utc" readonly="1"/>
                        <field name="last_cron_at_local" readonly="1"/>
                        <field name="last_cron_date" readonly="1"/>
                        <field name="last_cron_timezone" readonly="1"/>
                        <field name="last_cron_db_start" readonly="1"/>
                        <field name="last_cron_db_end" readonly="1"/>
                        <field name="last_cron_employee_count" readonly="1"/>
                        <field name="last_cron_log_count" readonly="1"/>
                        <field name="last_cron_created_count" readonly="1"/>
                        <field name="last_cron_updated_count" readonly="1"/>
                        <field name="last_cron_failed_count" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary" groups="t4tek_entry_control.group_entry_control_admin,base.group_system"/>
                    <button name="action_reset_default" type="object" string="Reset Default" class="btn-secondary" groups="t4tek_entry_control.group_entry_control_admin,base.group_system"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_entry_control_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">entry.control.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
